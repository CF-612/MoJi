{
  "name": "moji-chatgpt-workbench",
  "version": "0.11.0-v31.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-workbench.mjs && node scripts/build-demo.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "build:cloud": "node scripts/build-cloud.mjs",
    "cloud:dev": "wrangler dev --config cloud/wrangler.jsonc",
    "cloud:check": "wrangler deploy --config cloud/wrangler.jsonc --dry-run",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:cloud": "node --test cloud/tests/*.test.mjs",
    "build:workbench": "node scripts/build-workbench.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "esbuild": "^0.25.0",
    "jose": "^6.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  },
  "displayName": "墨叽 · 小说工作台",
  "description": "墨叽：陪你写故事的烟灰蛸小说工作台，支持正文、自由画布、情节连线与人物世界资料。",
  "moji": {
    "id": "moji",
    "englishName": "Moji",
    "updateManifestUrl": "https://raw.githubusercontent.com/CF-612/MoJi/moji-release/distribution/latest.json"
  }
}
