{
  "$schema": "integrations/chatgpt-workbench/node_modules/wrangler/config-schema.json",
  "name": "moji-workbench",
  "main": "integrations/chatgpt-workbench/cloud/entry.mjs",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "build": {"command": "npm run build:workbench --prefix integrations/chatgpt-workbench && npm run build:cloud --prefix integrations/chatgpt-workbench"},
  "vars": {"MOJI_AUTH": "builtin", "TRANSFER_DISABLED": "0"},
  "assets": {"directory": "integrations/chatgpt-workbench/cloud/public", "binding": "ASSETS", "run_worker_first": true},
  "kv_namespaces": [{"binding": "OAUTH_KV"}],
  "d1_databases": [{"binding": "DB", "database_name": "moji-workbench", "migrations_dir": "integrations/chatgpt-workbench/cloud/migrations"}],
  "durable_objects": {"bindings": [{"name": "WORKBENCH_RUNTIME", "class_name": "WorkbenchRuntime"}, {"name": "LOGIN_GUARD", "class_name": "LoginGuard"}]},
  "migrations": [{"tag": "workbench-runtime-v1", "new_sqlite_classes": ["WorkbenchRuntime"]}, {"tag": "moji-login-v1", "new_sqlite_classes": ["LoginGuard"]}],
  "observability": {"enabled": true}
}
